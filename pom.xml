<?xml version="1.0" encoding="UTF-8"?>
<!--
  ALBE Customer Limit Management - Maven build

  Build only            : mvn clean package          -> target/ALBECustomerLimit.jar
  Build + deploy to T24 : mvn clean deploy           -> removes the old JAR(s) ${deploy.old.jars} in ${deploy.dir}
                                                         on the T24 server, copies the new one (SSH / SCP)
  Restart T24 (separate): mvn antrun:run@restart-t24  -> deploy/restart_t24.sh on the server (stop JBoss, start,
                                                         wait for "started")

  Local settings (set once below, or pass on the command line with -Dname=value):
    t24.home        folder with TAFJ/lib, TAFJ/ext and T24/bnk/t24lib (the R25 libraries, compile only)
    l3.tables.dir   folder with the generated ALBE table JARs (compile only)
    deploy.*        T24 server, user, password, folder

  The T24 / TAFJ / table JARs are "system" dependencies: used to compile, never packed into our JAR
  (T24 already has them at run time).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.temenos.ALBE</groupId>
    <artifactId>ALBECustomerLimit</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>
    <name>ALBE Customer Limit Management</name>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- ===== Compile libraries (laptop) ===== -->
        <t24.home>C:/Temenos/R25</t24.home>
        <tafj.lib>${t24.home}/TAFJ/lib</tafj.lib>
        <tafj.ext>${t24.home}/TAFJ/ext</tafj.ext>
        <t24.lib>${t24.home}/T24/bnk/t24lib</t24.lib>
        <l3.tables.dir>${project.basedir}/lib/l3-tables</l3.tables.dir>
        <l3.table.customerlimit.jar>ALBE_CUSTOMER_LIMIT_TABLE.jar</l3.table.customerlimit.jar>
        <l3.table.genparam.jar>ALBE_GEN_PARAM_TABLE.jar</l3.table.genparam.jar>

        <!-- ===== Deploy to the T24 server (mvn clean deploy) ===== -->
        <deploy.host>172.16.229.77</deploy.host>
        <deploy.port>22</deploy.port>
        <deploy.dir>/srv/Temenos/T24/bnk/ALBElib</deploy.dir>
        <!--
          Server user / password - set them in ONE of these places:
            1. here: remove the comment marks around the two lines below and fill them in
               (then do not commit pom.xml with the password - GitHub is shared), or
            2. deploy.local.properties next to this pom (not in Git, see .gitignore):
                 deploy.user=...
                 deploy.password=...
            3. command line: mvn clean deploy -Ddeploy.user=... -Ddeploy.password=...
        <deploy.user>CHANGE_ME</deploy.user>
        <deploy.password>CHANGE_ME</deploy.password>
        -->
        <!-- old JARs of this project removed before the copy (only this pattern, other JARs untouched) -->
        <deploy.old.jars>ALBECustomerLimit*.jar</deploy.old.jars>
        <deploy.skip>false</deploy.skip>
        <!--
          Restart T24 (JBoss) - deploy/restart_t24.sh is sent over SSH and run in memory (no file is written
          on the server; only JBoss writes its own start-up log, as in the manual restart). Same steps as by hand:
          kill -15 the JBoss java process, wait until stopped, nohup ./standalone.sh -c Transact.xml,
          wait for "started" in the start-up log.
          Separate command (not part of clean deploy):  mvn antrun:run@restart-t24
          Restarting DEV affects everyone using it.
        -->
        <deploy.jboss.bin>/srv/Temenos/3rdParty/AS/jboss-eap-8.0/bin</deploy.jboss.bin>
        <deploy.jboss.config>Transact.xml</deploy.jboss.config>
        <deploy.startup.log>/tmp/tafj-startup.log</deploy.startup.log>
        <deploy.stop.wait>180</deploy.stop.wait>
        <deploy.start.wait>900</deploy.start.wait>
    </properties>

    <!-- T24 / TAFJ libraries needed to compile (found with javac -verbose against R25) -->
    <dependencies>
        <dependency><groupId>com.temenos.tafj</groupId><artifactId>TAFJClient</artifactId><version>R25</version><scope>system</scope><systemPath>${tafj.lib}/TAFJClient.jar</systemPath></dependency>
        <dependency><groupId>com.temenos.tafj</groupId><artifactId>TAFJAPICommon</artifactId><version>R25</version><scope>system</scope><systemPath>${tafj.lib}/TAFJAPICommon.jar</systemPath></dependency>
        <dependency><groupId>com.temenos.tafj</groupId><artifactId>TAFJLogging</artifactId><version>R25</version><scope>system</scope><systemPath>${tafj.lib}/TAFJLogging.jar</systemPath></dependency>
        <dependency><groupId>com.temenos.tafj</groupId><artifactId>json</artifactId><version>R25</version><scope>system</scope><systemPath>${tafj.ext}/json.jar</systemPath></dependency>
        <dependency><groupId>com.temenos.t24</groupId><artifactId>AA_ActivityHook</artifactId><version>R25</version><scope>system</scope><systemPath>${t24.lib}/AA_ActivityHook.jar</systemPath></dependency>
        <dependency><groupId>com.temenos.t24</groupId><artifactId>AA_Framework</artifactId><version>R25</version><scope>system</scope><systemPath>${t24.lib}/AA_Framework.jar</systemPath></dependency>
        <dependency><groupId>com.temenos.t24</groupId><artifactId>AA_PaymentSchedule</artifactId><version>R25</version><scope>system</scope><systemPath>${t24.lib}/AA_PaymentSchedule.jar</systemPath></dependency>
        <dependency><groupId>com.temenos.t24</groupId><artifactId>AA_ProductManagement</artifactId><version>R25</version><scope>system</scope><systemPath>${t24.lib}/AA_ProductManagement.jar</systemPath></dependency>
        <dependency><groupId>com.temenos.t24</groupId><artifactId>AC_AccountOpening</artifactId><version>R25</version><scope>system</scope><systemPath>${t24.lib}/AC_AccountOpening.jar</systemPath></dependency>
        <dependency><groupId>com.temenos.t24</groupId><artifactId>EB_DataAccessApi</artifactId><version>R25</version><scope>system</scope><systemPath>${t24.lib}/EB_DataAccessApi.jar</systemPath></dependency>
        <dependency><groupId>com.temenos.t24</groupId><artifactId>EB_EnquiryHook</artifactId><version>R25</version><scope>system</scope><systemPath>${t24.lib}/EB_EnquiryHook.jar</systemPath></dependency>
        <dependency><groupId>com.temenos.t24</groupId><artifactId>EB_ServiceHook</artifactId><version>R25</version><scope>system</scope><systemPath>${t24.lib}/EB_ServiceHook.jar</systemPath></dependency>
        <dependency><groupId>com.temenos.t24</groupId><artifactId>EB_SessionApi</artifactId><version>R25</version><scope>system</scope><systemPath>${t24.lib}/EB_SessionApi.jar</systemPath></dependency>
        <dependency><groupId>com.temenos.t24</groupId><artifactId>EB_TemplateHook</artifactId><version>R25</version><scope>system</scope><systemPath>${t24.lib}/EB_TemplateHook.jar</systemPath></dependency>
        <dependency><groupId>com.temenos.t24</groupId><artifactId>FT_Contract</artifactId><version>R25</version><scope>system</scope><systemPath>${t24.lib}/FT_Contract.jar</systemPath></dependency>
        <dependency><groupId>com.temenos.t24</groupId><artifactId>TT_Contract</artifactId><version>R25</version><scope>system</scope><systemPath>${t24.lib}/TT_Contract.jar</systemPath></dependency>
        <dependency><groupId>com.temenos.t24</groupId><artifactId>ST_CompanyCreation</artifactId><version>R25</version><scope>system</scope><systemPath>${t24.lib}/ST_CompanyCreation.jar</systemPath></dependency>
        <!-- D54: max CIF balance (Account API -> EB.CONTRACT.BALANCES) and conversion (Currency API) -->
        <dependency><groupId>com.temenos.t24</groupId><artifactId>AC_AccountApi</artifactId><version>R25</version><scope>system</scope><systemPath>${t24.lib}/AC_AccountApi.jar</systemPath></dependency>
        <dependency><groupId>com.temenos.t24</groupId><artifactId>ST_CurrencyApi</artifactId><version>R25</version><scope>system</scope><systemPath>${t24.lib}/ST_CurrencyApi.jar</systemPath></dependency>
        <!-- TODO D54: add the t24lib jar holding com.temenos.t24.api.records.ebcontractbalances.EbContractBalancesRecord (name to be confirmed on the server) -->
        <!-- generated ALBE table APIs (Design Studio) -->
        <dependency><groupId>com.temenos.ALBE</groupId><artifactId>ALBE_CUSTOMER_LIMIT_TABLE</artifactId><version>1.0</version><scope>system</scope><systemPath>${l3.tables.dir}/${l3.table.customerlimit.jar}</systemPath></dependency>
        <dependency><groupId>com.temenos.ALBE</groupId><artifactId>ALBE_GEN_PARAM_TABLE</artifactId><version>1.0</version><scope>system</scope><systemPath>${l3.tables.dir}/${l3.table.genparam.jar}</systemPath></dependency>
    </dependencies>

    <build>
        <!-- keep the existing Eclipse layout: sources in src/ -->
        <sourceDirectory>src</sourceDirectory>
        <!-- MUST stay ALBE_CustomerLimit: JBoss modules/com/temenos/t24/main/module.xml loads ./localLib/ALBE_CustomerLimit.jar by name -->
        <finalName>ALBE_CustomerLimit</finalName>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                    <compilerArgs>
                        <!-- the T24 JARs also contain .java files: never compile those -->
                        <arg>-implicit:none</arg>
                        <arg>-proc:none</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Implementation-Title>ALBE Customer Limit</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                            <Build-Time>${maven.build.timestamp}</Build-Time>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- no Maven repository upload: "deploy" means copy to the T24 server (below) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>3.1.3</version>
                <configuration><skip>true</skip></configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.1.3</version>
                <configuration><skip>true</skip></configuration>
            </plugin>

            <!-- mvn deploy: remove the old JAR on the T24 server, copy the new one -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>deploy-to-t24</id>
                        <phase>deploy</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <skip>${deploy.skip}</skip>
                            <target>
                                <!-- user / password from deploy.local.properties when not set in the pom or -D -->
                                <property file="${project.basedir}/deploy.local.properties"/>
                                <fail unless="deploy.user" message="Set deploy.user (pom.xml, deploy.local.properties or -Ddeploy.user=...)"/>
                                <fail unless="deploy.password" message="Set deploy.password (pom.xml, deploy.local.properties or -Ddeploy.password=...)"/>
                                <echo message="T24 deploy: ${deploy.user}@${deploy.host}:${deploy.dir}"/>
                                <sshexec host="${deploy.host}" port="${deploy.port}" username="${deploy.user}"
                                         password="${deploy.password}" trust="true" failonerror="true"
                                         command="cd '${deploy.dir}' &amp;&amp; ls -l ${project.build.finalName}.jar ${deploy.old.jars} 2&gt;/dev/null; rm -f ${deploy.old.jars}; echo 'wrong-name copies removed (if any)'"/>
                                <!-- copy to a temporary name, then rename: the JAR the T24 module loads is never missing -->
                                <scp file="${project.build.directory}/${project.build.finalName}.jar"
                                     remoteTofile="${deploy.user}@${deploy.host}:${deploy.dir}/${project.build.finalName}.jar.new"
                                     port="${deploy.port}" password="${deploy.password}" trust="true"/>
                                <sshexec host="${deploy.host}" port="${deploy.port}" username="${deploy.user}"
                                         password="${deploy.password}" trust="true" failonerror="true"
                                         command="cd '${deploy.dir}' &amp;&amp; mv -f ${project.build.finalName}.jar.new ${project.build.finalName}.jar &amp;&amp; echo 'replaced ${project.build.finalName}.jar'"/>
                                <sshexec host="${deploy.host}" port="${deploy.port}" username="${deploy.user}"
                                         password="${deploy.password}" trust="true" failonerror="true"
                                         command="ls -l '${deploy.dir}/${project.build.finalName}.jar'"/>
                                <echo message="Deployed ${project.build.finalName}.jar - restart T24 to load it: mvn antrun:run@restart-t24"/>
                            </target>
                        </configuration>
                    </execution>
                    <!-- restart T24: separate command, mvn antrun:run@restart-t24 (not bound to a phase) -->
                    <execution>
                        <id>restart-t24</id>
                        <phase>none</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <property file="${project.basedir}/deploy.local.properties"/>
                                <echo message="T24 restart on ${deploy.host} (${deploy.jboss.bin} -c ${deploy.jboss.config})"/>
<!-- the script is sent over SSH and run with "bash -s": no file is written on the server -->
                                <sshexec host="${deploy.host}" port="${deploy.port}" username="${deploy.user}"
                                         password="${deploy.password}" trust="true" failonerror="true"
                                         timeout="1500000" input="${project.basedir}/deploy/restart_t24.sh"
                                         command="bash -s -- '${deploy.jboss.bin}' '${deploy.jboss.config}' '${deploy.startup.log}' ${deploy.stop.wait} ${deploy.start.wait}"/>
                                <echo message="T24 restarted - new JAR loaded"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.ant</groupId>
                        <artifactId>ant-jsch</artifactId>
                        <version>1.10.15</version>
                        <exclusions>
                            <exclusion><groupId>com.jcraft</groupId><artifactId>jsch</artifactId></exclusion>
                        </exclusions>
                    </dependency>
                    <!-- maintained JSch fork (same package), supports current SSH key / cipher types -->
                    <dependency>
                        <groupId>com.github.mwiede</groupId>
                        <artifactId>jsch</artifactId>
                        <version>0.2.20</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
